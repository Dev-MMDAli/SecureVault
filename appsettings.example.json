{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=SecureVault.db"
  },
  "JwtSettings": {
    "Secret": "YOUR_SECRET_KEY_HERE_AT_LEAST_32_CHARS",
    "Issuer": "SecureVault",
    "Audience": "SecureVaultUsers",
    "ExpirationInMinutes": 60
  },
  "Encryption": {
    "Key": "YOUR_32_CHAR_ENCRYPTION_KEY_HERE",
    "IV": "YOUR_16_CHAR_IV"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}